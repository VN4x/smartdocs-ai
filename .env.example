# Copy to .env and fill in values from your Supabase project (Lovable Cloud → Supabase).
# Never commit .env — it is gitignored.

# Server + client (public)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only — never expose as VITE_* (set in Lovable Cloud secrets)
SUPABASE_SERVICE_ROLE_KEY=
